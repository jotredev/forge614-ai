{
  "$id": "https://forge614.dev/schemas/error-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "code",
    "error"
  ],
  "additionalProperties": false
}
