{
  "$id": "https://forge614.dev/schemas/rule-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^([a-z0-9]+)-(rule|skill|mcp|plugin|policy|pack)-([a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "level": {
      "type": "string",
      "enum": [
        "core",
        "stack",
        "optional"
      ]
    },
    "title": {
      "type": "object",
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "es",
        "en"
      ],
      "additionalProperties": false
    },
    "appliesWhen": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fileExists": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fileExists"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "anyFileMatches": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "anyFileMatches"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "validator": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}$"
      }
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "compensates": {
      "type": "string",
      "enum": [
        "model-limitation",
        "structural"
      ]
    },
    "sunset": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "reviewBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "condition",
        "reviewBy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "version",
    "level",
    "title",
    "appliesWhen",
    "decisions"
  ],
  "additionalProperties": false
}
