{
  "$id": "https://forge614.dev/schemas/decisions-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "propuesta",
              "aceptada",
              "revocada",
              "reemplazada"
            ]
          },
          "replacedBy": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "session": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "number",
          "slug",
          "title",
          "status",
          "date",
          "file"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "decisions"
  ],
  "additionalProperties": false
}
