new file mode 100644
index 0000000..5996b04
--- /dev/null
+++ b/src/app/check-standard-version-lock.test.ts
@@ -0,0 +1,106 @@
+import { expect, test } from "bun:test";
+import { execFileSync } from "node:child_process";
+import { cpSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { checkStandardVersionLock } from "./check-standard-version-lock";
+
+const REPO_ROOT = resolve(import.meta.dir, "../..");
+
+function git(root: string, ...args: string[]): void {
+  execFileSync("git", args, { cwd: root, stdio: "ignore" });
+}
+
+function fixture(): string {
+  const root = mkdtempSync(join(tmpdir(), "standard-version-lock-"));
+  cpSync(join(REPO_ROOT, "standard"), join(root, "standard"), { recursive: true });
+  writeFileSync(join(root, "standard/VERSION"), "9.9.9\n");
+  git(root, "init", "--quiet");
+  git(root, "config", "user.name", "Forge614 test");
+  git(root, "config", "user.email", "test@example.invalid");
+  git(root, "add", "standard");
+  git(root, "commit", "--quiet", "-m", "baseline");
+  git(root, "tag", "standard-v9.9.9");
+  return root;
+}
+
+/**
+ * Confirms a tagged standard cannot change while its VERSION remains fixed.
+ * A temporary Git repository gives the test a real standard tree and tag lookup.
+ */
+test("fails with STANDARD_VERSION_NOT_BUMPED when standard changes under its version tag", () => {
+  const root = fixture();
+  try {
+    writeFileSync(join(root, "standard/STANDARD.md"), "changed\n");
+    const result = checkStandardVersionLock({ root, standardVersion: "9.9.9" });
+    expect(result).toMatchObject({ ok: false, code: "STANDARD_VERSION_NOT_BUMPED" });
+    if (result.ok) return;
+    expect(result.error).toBe("standard/ cambió desde standard-v9.9.9; sube standard/VERSION");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+/**
+ * Confirms a release check succeeds when the tagged standard matches the current tree byte for byte.
+ * This is the success path used by the standard-release workflow after publishing a version tag.
+ */
+test("passes when the tagged standard matches the current tree", () => {
+  const root = fixture();
+  try {
+    expect(checkStandardVersionLock({ root, standardVersion: "9.9.9" })).toEqual({ ok: true });
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+/**
+ * Confirms raising VERSION makes the current tree a new, unpublished release and allows it through.
+ * The fixture keeps the previous release tag so the check also proves tag availability.
+ */
+test("passes with a new VERSION that has no release tag yet", () => {
+  const root = fixture();
+  try {
+    writeFileSync(join(root, "standard/VERSION"), "9.9.10\n");
+    writeFileSync(join(root, "standard/STANDARD.md"), "changed\n");
+    expect(checkStandardVersionLock({ root, standardVersion: "9.9.10" })).toEqual({ ok: true });
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+/**
+ * Confirms an unpublished version passes when another standard tag proves the clone has tag history.
+ * This distinguishes a genuinely new version from a shallow clone with no tags available at all.
+ */
+test("passes when the current VERSION has no tag and other tags are available", () => {
+  const root = fixture();
+  try {
+    expect(checkStandardVersionLock({ root, standardVersion: "9.9.10" })).toEqual({ ok: true });
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+/**
+ * Confirms a tagless clone fails clearly instead of silently skipping the version lock.
+ * The error directs the caller to fetch the full tag history before checking the standard.
+ */
+test("fails clearly when the repository has no tags", () => {
+  const root = mkdtempSync(join(tmpdir(), "standard-version-lock-no-tags-"));
+  cpSync(join(REPO_ROOT, "standard"), join(root, "standard"), { recursive: true });
+  writeFileSync(join(root, "standard/VERSION"), "9.9.9\n");
+  git(root, "init", "--quiet");
+  git(root, "config", "user.name", "Forge614 test");
+  git(root, "config", "user.email", "test@example.invalid");
+  git(root, "add", "standard");
+  git(root, "commit", "--quiet", "-m", "baseline");
+  try {
+    const result = checkStandardVersionLock({ root, standardVersion: "9.9.9" });
+    expect(result).toMatchObject({ ok: false, code: "STANDARD_TAGS_UNAVAILABLE" });
+    if (result.ok) return;
+    expect(result.error).toContain("git fetch --tags");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
diff --git a/src/app/check-standard-version-lock.ts b/src/app/check-standard-version-lock.ts
new file mode 100644
index 0000000..c15d501
--- /dev/null
+++ b/src/app/check-standard-version-lock.ts
@@ -0,0 +1,92 @@
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { packStandard } from "./pack-standard";
+
+export interface CheckStandardVersionLockOptions {
+  root: string;
+  standardVersion: string;
+}
+
+export type CheckStandardVersionLockResult =
+  | { ok: true }
+  | { ok: false; code: "STANDARD_VERSION_NOT_BUMPED" | "STANDARD_TAGS_UNAVAILABLE"; error: string };
+
+/** Runs Git in the target repository and returns its stdout bytes. */
+function git(root: string, ...args: string[]): Buffer {
+  return execFileSync("git", args, { cwd: root, stdio: ["ignore", "pipe", "pipe"] });
+}
+
+/** Writes the regular files from a tagged standard tree into a temporary directory. */
+function snapshotStandardFromTag(root: string, tag: string, standardDir: string): void {
+  const entries = git(root, "ls-tree", "-r", "-z", "--full-tree", tag, "--", "standard").toString("utf8");
+  for (const entry of entries.split("\0")) {
+    if (!entry) continue;
+    const tab = entry.indexOf("\t");
+    const metadata = entry.slice(0, tab);
+    const relativePath = entry.slice(tab + 1);
+    const [mode, kind, object] = metadata.split(" ");
+    if (!object || kind !== "blob" || (mode !== "100644" && mode !== "100755")) continue;
+    const target = join(standardDir, relativePath.slice("standard/".length));
+    mkdirSync(dirname(target), { recursive: true });
+    writeFileSync(target, git(root, "cat-file", "blob", object));
+  }
+}
+
+/**
+ * Compares the current standard package with the package at its release tag.
+ * @param options Repository root and current standard version.
+ * @returns Success, a missing-version-bump error, or an explicit missing-tag-history error.
+ */
+export function checkStandardVersionLock(options: CheckStandardVersionLockOptions): CheckStandardVersionLockResult {
+  let tags: string;
+  try {
+    tags = git(options.root, "tag", "--list").toString("utf8").trim();
+  } catch {
+    return {
+      ok: false,
+      code: "STANDARD_TAGS_UNAVAILABLE",
+      error: "No se pudieron leer las etiquetas de Git; trae el historial completo con `git fetch --tags` antes de ejecutar standard:check. Git tags are unavailable; fetch them with `git fetch --tags` before running standard:check.",
+    };
+  }
+  if (!tags) {
+    return {
+      ok: false,
+      code: "STANDARD_TAGS_UNAVAILABLE",
+      error: "El repositorio no tiene etiquetas; trae el historial completo con `git fetch --tags` antes de ejecutar standard:check. The repository has no tags; fetch them with `git fetch --tags` before running standard:check.",
+    };
+  }
+
+  const tag = `standard-v${options.standardVersion}`;
+  try {
+    git(options.root, "rev-parse", "--verify", "--quiet", `refs/tags/${tag}`);
+  } catch {
+    return { ok: true };
+  }
+
+  const snapshotRoot = mkdtempSync(join(tmpdir(), "standard-version-lock-snapshot-"));
+  const packRoot = mkdtempSync(join(tmpdir(), "standard-version-lock-pack-"));
+  try {
+    snapshotStandardFromTag(options.root, tag, join(snapshotRoot, "standard"));
+    const taggedPack = packStandard(snapshotRoot, packRoot);
+    const currentPack = packStandard(options.root, packRoot);
+    if (taggedPack.sha256 !== currentPack.sha256) {
+      return {
+        ok: false,
+        code: "STANDARD_VERSION_NOT_BUMPED",
+        error: `standard/ cambió desde ${tag}; sube standard/VERSION`,
+      };
+    }
+    return { ok: true };
+  } catch {
+    return {
+      ok: false,
+      code: "STANDARD_TAGS_UNAVAILABLE",
+      error: `No se pudo leer ${tag}; trae el historial completo con git fetch --tags antes de ejecutar standard:check. Could not read ${tag}; fetch the full history with git fetch --tags before running standard:check.`,
+    };
+  } finally {
+    rmSync(snapshotRoot, { recursive: true, force: true });
+    rmSync(packRoot, { recursive: true, force: true });
+  }
+}
